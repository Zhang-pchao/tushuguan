@article{Bobbin_DigitDiscov_2024_v3_p264,
  title        = {{Formalizing chemical physics using the Lean theorem prover}},
  author       = {
    Maxwell P. Bobbin and Samiha Sharlin and Parivash Feyzishendi and An Hong
    Dang and Catherine M. Wraback and Tyler R. Josephson
  },
  year         = 2024,
  journal      = {Digit. Discov.},
  volume       = 3,
  number       = 2,
  pages        = {264--280},
  doi          = {10.1039/d3dd00077j},
  abstract     = {
    Theories in chemical physics can be reconstructed in a formal language
    using the interactive theorem prover, Lean. Lean{\textquoteright}s ability
    to check math theorems catches faulty logic and reveals hidden assumptions
    that are missed in informal derivations.
  },
}
