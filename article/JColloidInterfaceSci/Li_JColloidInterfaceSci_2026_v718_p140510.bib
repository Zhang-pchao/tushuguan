@article{Li_JColloidInterfaceSci_2026_v718_p140510,
  title        = {
    {Size Effect and Excess Surface Energy Conversion in Bubble Coalescence
    Dynamics}
  },
  author       = {
    Jinfeng Li and Yonglu She and Tengfei Nie and Jingyi Cheng and Zeyuan Duan
    and Liejin Guo and Qiang Xu
  },
  year         = 2026,
  journal      = {J. Colloid Interface Sci.},
  volume       = 718,
  pages        = 140510,
  doi          = {10.1016/j.jcis.2026.140510},
  abstract     = {
    The spontaneous detachment behavior of bubbles after coalescence is crucial
    for enhancing the efficiency of photoelectrochemical (PEC) water splitting.
    However, the coalescence of unequal-sized bubbles exhibits pronounced
    asymmetry, and their coalescence, detachment, and oscillatory dynamics are
    strongly governed by the size effect. Inspired by the photothermal effect
    of photocatalysts, this study utilized Marangoni convection to guide bubble
    coalescence non- invasively and investigated in situ how size effect
    affects bubble coalescence dynamics. At low Ohnesorge numbers (Oh) and high
    Reynolds numbers, the neck expansion of unequal-sized bubbles is dominated
    by inertia and can be accurately described by modifying the capillary-
    inertial model. A theoretical critical Oh predicts whether coalescence can
    result in bubble jumping or detachment, determined by the balance between
    surface energy, viscous dissipation, and interfacial adhesion. It is found
    that less than 3{\%} of excess surface energy is converted into
    translational kinetic energy that promotes detachment, and the conversion
    efficiency is negatively correlated with the radius ratio. We develop a
    surface energy conversion efficiency model incorporating Oh and size
    mismatch that successfully predicts bubble detachment velocities. After
    detachment, bubbles oscillate at their natural frequency, with the damping
    coefficient scaling inversely with the square root of the smaller bubble
    radius.
  },
}
