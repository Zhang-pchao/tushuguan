@article{Maheshwari_Langmuir_2016_v32_p11116,
  title        = {{Stability of Surface Nanobubbles: A Molecular Dynamics Study}},
  author       = {
    Shantanu Maheshwari and Martin {van der Hoef} and Xuehua Zhang and Detlef
    Lohse
  },
  year         = 2016,
  journal      = {Langmuir},
  volume       = 32,
  number       = 43,
  pages        = {11116--11122},
  doi          = {10.1021/acs.langmuir.6b00963},
  abstract     = {
    The stability and growth or dissolution of a single surface nanobubble on a
    chemically patterned surface are studied by molecular dynamics simulations
    of binary mixtures consisting of Lennard-Jones (LJ) particles. Our
    simulations reveal how pinning of the three-phase contact line on the
    surface can lead to the stability of the surface nanobubble, provided that
    the concentration of the dissolved gas is oversaturated. We have performed
    equilibrium simulations of surface nanobubbles at different gas
    oversaturation levels {\ensuremath{\zeta}} {\ensuremath{>}} 0. The
    equilibrium contact angle {\ensuremath{\theta}}e is found to follow the
    theoretical result of Lohse and Zhang (Phys. Rev. E 2015, 91, 031003(R)),
    namely, sin {\ensuremath{\theta}}e = {\ensuremath{\zeta}}L/Lc, where L is
    the pinned length of the footprint and Lc = 4{\ensuremath{\gamma}}/P0 is a
    capillary length scale, where {\ensuremath{\gamma}} is the surface tension
    and P0 is the ambient pressure. For undersaturation {\ensuremath{\zeta}}
    {\ensuremath{<}} 0 the surface nanobubble dissolves and the dissolution
    dynamics shows a {''}stick-jump{''} behavior of the three-phase contact
    line.
  },
}
