@article{Wang_ProcNatlAcadSciUSA_2011_v108_p6374,
  title        = {
    {Probing Surface Tension Additivity on Chemically Heterogeneous Surfaces by
    a Molecular Approach}
  },
  author       = {Jihang Wang and Dusan Bratko and Alenka Luzar},
  year         = 2011,
  journal      = {Proc. Natl. Acad. Sci. U. S. A.},
  volume       = 108,
  number       = 16,
  pages        = {6374--6379},
  doi          = {10.1073/pnas.1014970108},
  abstract     = {
    Surface free energy of a chemically heterogeneous surface is often treated
    as an approximately additive quantity through the Cassie equation [Cassie
    ABD (1948) Discuss Faraday Soc 3:11-16]. However, deviations from
    additivity are common, and molecular interpretations are still lacking. We
    use molecular simulations to measure the microscopic analogue of contact
    angle, {\ensuremath{\Theta}}(c), of aqueous nanodrops on heterogeneous
    synthetic and natural surfaces as a function of surface composition. The
    synthetic surfaces are layers of graphene functionalized with prototypical
    nonpolar and polar head group: methyl, amino, and nitrile. We demonstrate
    positive as well as negative deviations from the linear additivity. We show
    the deviations reflect the uneven exposure of mixture components to the
    solvent and the linear relation is recovered if fractions of
    solvent-accessible surface are used as the measure of composition. As the
    spatial variations in polarity become of larger amplitude, the linear
    relation can no longer be obtained. Protein surfaces represent such natural
    patterned surfaces, also characterized by larger patches and roughness. Our
    calculations reveal strong deviations from linear additivity on a
    prototypical surface comprising surface fragments of melittin dimer. The
    deviations reflect the disproportionately strong influence of isolated
    polar patches, preferential wetting, and changes in the position of the
    liquid interface above hydrophobic patches. Because solvent-induced
    contribution to the free energy of surface association grows as cos
    {\ensuremath{\Theta}}(c), deviations of cos {\ensuremath{\Theta}}(c) from
    the linear relation directly reflect nonadditive adhesive energies of
    biosurfaces.
  },
}
