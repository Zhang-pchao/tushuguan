@article{Qin_PhysFluids_2026_v38_p117415,
  title        = {
    {Coalescence mechanisms of micro- and nanobubbles: Insights from in situ
    imaging and multiphysics modeling}
  },
  author       = {Ling Qin and Mohammad Piri},
  year         = 2026,
  journal      = {Phys. Fluids},
  volume       = 38,
  number       = 11,
  pages        = 117415,
  doi          = {10.1063/5.0358793},
  abstract     = {
    Nanobubbles (NBs), due to their ultrafine size, high specific surface area,
    and long-term stability, play a crucial role in various industries such as
    oil and gas extraction, mineral flotation, and water purification. In these
    applications, NB coalescence is particularly important because it can drive
    the transition from stable NBs to larger and less persistent microbubbles
    (MBs), thereby affecting the stability and functional effectiveness of NBs
    during treatment. However, the coalescence dynamics of NBs remain poorly
    understood due to the lack of suitable imaging tools capable of visualizing
    nanoscale bubbles in liquid environments. Here, we combine high-resolution
    in situ imaging, machine learning-based imaging recognition, and
    volume-of-fluid (VOF) model to resolve the drainage dynamics governing
    micro- and nanobubble interactions. We find that NBs coalesce substantially
    more slowly than MBs, with drainage times approximately two orders of
    magnitude longer. Classical no-slip models substantially overestimate the
    drainage time of NBs, whereas VOF simulations capture the experimentally
    observed coalescence dynamics and associated interfacial deformation.
    Importantly, the persistence and coalescence of NBs arise from distinct
    physical mechanisms: their long-term persistence is associated with
    electrostatic double-layer repulsion and ion-mediated interfacial
    stabilization, whereas their slow coalescence is governed by the coupled
    effects of Laplace pressure and interfacial film drainage. These findings
    provide a mechanistic understanding of bubble{\textendash}bubble
    interactions across micro- and nanoscale regimes and establish a basis for
    evaluating and controlling NB behavior in enhanced oil recovery, wastewater
    treatment, and other interfacial processes.
  },
}
