@article{Jeong_IeeeTransSemicondManufact_2026_v39_p388,
  title        = {
    {Investigation of Radial Micro-Bubble Defects Caused by Organic
    Contamination}
  },
  author       = {Jaein Jeong and Eun a Ko and Youngjeong Kim},
  year         = 2026,
  journal      = {Ieee Trans. Semicond. Manufact.},
  volume       = 39,
  number       = 3,
  pages        = {388--394},
  doi          = {10.1109/tsm.2026.3702942},
  abstract     = {
    An investigation into the origin and control strategies for a distinct
    defect characterized by radial wafer maps was conducted during the spin-on
    hard-mask (SOH), photo resist (PR), and spin-on dielectric (SOD) coating
    processes. It was found that this defect is closely associated with wafer
    review or critical dimension (CD) measurements using a scanning electron
    microscope (SEM) instrument prior to the coating process, and appears in
    the form of micro-bubbles. To elucidate the formation dynamics, surface
    contamination analysis, contact angle, thermal desorption, and potential
    measurements were performed. The results indicated a mechanism for bubble
    generation resulting from locally inhomogeneous wafer surface
    hydrophobization caused by carbon-compound-based contamination in a vacuum
    SEM chamber. The hydrophobization leads to bubble nucleation and air
    entrapment during the acceleration coating stage. As preventive measures,
    the organic contamination source has been reduced by cleaning the SEM
    chamber, and it has also been demonstrated that implementing enhanced
    double reducing resist consumption (RRC) in the photolithography process is
    an effective solution.
  },
}
