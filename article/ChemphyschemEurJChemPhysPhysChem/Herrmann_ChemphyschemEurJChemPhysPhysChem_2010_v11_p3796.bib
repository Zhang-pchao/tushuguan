@article{Herrmann_ChemphyschemEurJChemPhysPhysChem_2010_v11_p3796,
  title        = {
    {Tropospheric aqueous-phase free-radical chemistry: radical sources,
    spectra, reaction kinetics and prediction tools}
  },
  author       = {
    Hartmut Herrmann and Dirk Hoffmann and Thomas Schaefer and Peter Br{\"a}uer
    and Andreas Tilgner
  },
  year         = 2010,
  journal      = {ChemPhysChem},
  volume       = 11,
  number       = 18,
  pages        = {3796--822},
  doi          = {10.1002/cphc.201000533},
  abstract     = {
    The most important radicals which need to be considered for the description
    of chemical conversion processes in tropospheric aqueous systems are the
    hydroxyl radical, the nitrate radical, and sulfur-containing radicals. This
    review summarizes aqueous-phase kinetic data and prediction tools relevant
    to multiphase tropospheric chemistry.
  },
}
