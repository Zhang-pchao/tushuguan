@article{Song_LangmuirAcsJSurfColloids_2011_v27_p8223,
  title        = {
    {Contact angles of surface nanobubbles on mixed self-assembled monolayers
    with systematically varied macroscopic wettability by atomic force
    microscopy}
  },
  author       = {Bo Song and Wiktoria Walczyk and Holger Sch{\"o}nherr},
  year         = 2011,
  journal      = {Langmuir: Acs J. Surf. Colloids},
  volume       = 27,
  number       = 13,
  pages        = {8223--32},
  doi          = {10.1021/la2014896},
  abstract     = {
    The dependence of the properties of so-called {''}surface nanobubbles{''}
    at the interface of binary self-assembled monolayers (SAMs) of
    octadecanethiol (ODT) and 16-mercaptohexadecanoic acid (MHDA) on ultraflat
    template-stripped gold and water on the surface composition was studied
    systematically by in situ atomic force microscopy (AFM). The macroscopic
    water contact angle ({\ensuremath{\theta}}(macro)) of the SAMs spanned the
    range between 107{\textdegree} {\ensuremath{\pm}} 1{\textdegree} and
    15{\textdegree} {\ensuremath{\pm}} 3{\textdegree}. Surface nanobubbles were
    observed on all SAMs by intermittent contact-mode AFM; their size and
    contact angle were found to depend on the composition of the SAM. In
    particular, nanoscopic contact angles {\ensuremath{\theta}}(nano)
    {\ensuremath{<}} 86{\textdegree} were observed for the first time for
    hydrophilic surfaces. From fits of the top of the bubble profile to a
    spherical cap in three dimensions, quantitative estimates of nanobubble
    height, width, and radius of curvature were obtained. Values of
    {\ensuremath{\theta}}(nano) calculated from these data were found to change
    from 167{\textdegree} {\ensuremath{\pm}} 3{\textdegree} to 33{\textdegree}
    {\ensuremath{\pm}} 58{\textdegree}, when {\ensuremath{\theta}}(macro)
    decreased from 107{\textdegree} {\ensuremath{\pm}} 1{\textdegree} to
    37{\textdegree} {\ensuremath{\pm}} 3{\textdegree}. While the values for
    {\ensuremath{\theta}}(nano) significantly exceeded those of
    {\ensuremath{\theta}}(macro) for hydrophobic SAMs, which is fully in line
    with previous reports, this discrepancy became less pronounced and finally
    vanished for more hydrophilic surfaces.
  },
}
