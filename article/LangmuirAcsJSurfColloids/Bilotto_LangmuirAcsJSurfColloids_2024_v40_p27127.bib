@article{Bilotto_LangmuirAcsJSurfColloids_2024_v40_p27127,
  title        = {
    {Removal of Nanoparticles by Surface Nanobubbles Generated via Solvent-
    Water Exchange: A Critical Perspective}
  },
  author       = {
    Pierluigi Bilotto and Daniela Miano and Alper Tunga Celebi and Markus
    Valtiner
  },
  year         = 2024,
  journal      = {Langmuir: Acs J. Surf. Colloids},
  volume       = 40,
  number       = 52,
  pages        = {27127--27136},
  doi          = {10.1021/acs.langmuir.4c02862},
  abstract     = {
    The swift progression of technology in electronic fabrication is adhering
    to a trend of miniaturization, descending to the nanoscale. Surface
    contaminants, such as nanoparticles, can influence the performance of
    silicon wafers, thereby necessitating the evolution of novel cleaning
    methodologies. Surface nanobubbles (SNs) are phenomena that have attracted
    considerable attention over the past decade. A salient feature of SNs is
    their capacity to eliminate nanoparticles from silicon wafers. In this
    Perspective, our objective is to scrutinize whether this capability can be
    unequivocally ascribed to SNs. Initially, we offer a succinct elucidation
    of the nature of SNs; subsequently, we evaluate the claims regarding the
    cleaning efficacy of SNs; finally, we present our interpretation of the
    operative forces and propose potential scenarios of the interaction between
    SNs and nanoparticles. Consequently, the aim of this Perspective is to
    emphasize the significance of comprehending the interaction between SNs and
    nanoparticles with the intent to delineate new research trajectories
    bearing both fundamental and industrial ramifications.
  },
}
